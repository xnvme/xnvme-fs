# What CI's runner has for building the adapters, so a local build makes the same binaries the QEMU guest then tests.
# The release is the guest's: uPCIe takes the iommufd path there, and its mapping of HOMI's memory
# needs IOMMU_IOAS_MAP_FILE, which kernel headers before 6.14 lack.
ARG UBUNTU=26.04
FROM docker.io/library/ubuntu:${UBUNTU}
COPY scripts/ci-deps.sh /tmp/ci-deps.sh
RUN sh /tmp/ci-deps.sh && rm -rf /var/lib/apt/lists/* /tmp/ci-deps.sh
ENV GEN=ninja CCACHE_DIR=/ccache CMAKE_C_COMPILER_LAUNCHER=ccache CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CCACHE_MAXSIZE=5G CCACHE_COMPRESS=true
WORKDIR /src/adapters
